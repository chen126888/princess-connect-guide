# ─────────────────────────────────────────────────────────────
# 環境變數範本 —— 複製為 .env 後填入實際值（.env 已被 gitignore）
#
# 各 Phase 陸續會用到的變數都列在此處；尚未進行到的 Phase
# 可先留空。對應說明見 ARCHITECTURE.md。
# ─────────────────────────────────────────────────────────────

# ── 資料庫（Phase 2）
# 本地開發指向 docker-compose 的 Postgres；上雲後改為 Supabase 連線字串
DATABASE_URL=postgresql://pcr:pcr@localhost:5432/princess_connect

# docker-compose 的 Postgres 初始化參數（僅本地開發用）
POSTGRES_USER=pcr
POSTGRES_PASSWORD=pcr
POSTGRES_DB=princess_connect

# ── API（Phase 3）
NODE_ENV=development
API_PORT=3000
# 允許的前端來源，逗號分隔
CORS_ORIGINS=http://localhost:5173

# ── 認證（Phase 6）
# 產生方式：node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── 圖片儲存 Cloudflare R2（Phase 7）
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# R2 公開網址，前端直接引用（不再經後端 redirect，見 §9.3）
R2_PUBLIC_URL=

# ── 前端（Phase 5）
VITE_API_BASE_URL=http://localhost:3000/api
# 本地開發指向本地靜態服務；生產環境填 R2 公開網址
VITE_IMAGE_BASE_URL=http://localhost:3000/images

# ── 監控（Phase 4）
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
